NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roadly
# Replace with independent cryptographically random secrets (at least 32 characters).
JWT_SECRET=replace-with-a-random-access-secret-before-running
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-before-running
# Exact origin, no path or trailing slash. HTTPS required in production.
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=strict
# Only increase for a known, fixed reverse-proxy topology.
TRUST_PROXY=0

# Optional administrative provisioning; set locally, never commit real credentials.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=Roadly Admin
